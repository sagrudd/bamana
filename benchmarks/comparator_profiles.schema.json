{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamana.dev/benchmarks/comparator_profiles.schema.json",
  "title": "Bamana Aligned Comparator Profiles",
  "description": "Governed catalog of measured benchmark comparator profiles whose semantic assumptions are explicit.",
  "x-bamana-m14-comparator-profile-task": "M14.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "type": "string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "command_family",
        "evidence_level",
        "benchmark_runner",
        "bamana_path",
        "comparator_path",
        "result_artifacts",
        "semantic_equivalence_assumptions",
        "unsupported_mismatch_cases",
        "release_claim_boundary"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["fastq_ingress", "fastq_gz_enumerate"]
        },
        "status": {
          "type": "string",
          "enum": ["measured_public_profile", "planned", "retired"]
        },
        "command_family": { "const": "public_profile" },
        "evidence_level": { "const": "public_profile_comparator" },
        "benchmark_runner": { "type": "string", "minLength": 1 },
        "bamana_path": { "type": "string", "minLength": 1 },
        "comparator_path": { "type": "string", "minLength": 1 },
        "result_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_equivalence_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unsupported_mismatch_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "release_claim_boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
