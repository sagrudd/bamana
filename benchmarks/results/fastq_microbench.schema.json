{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamana.dev/benchmarks/results/fastq_microbench.schema.json",
  "title": "Bamana Native FASTQ Microbenchmark Result",
  "x-bamana-benchmark-contract-version": "1.0.0",
  "x-bamana-m14-post-m10-command-families": {
    "task": "M14.3",
    "runtime_behavior": "unchanged",
    "families": {
      "fastq": [
        "enumerate_fastq",
        "enumerate_fastq_gz",
        "subsample_fastq",
        "subsample_fastq_gz"
      ]
    },
    "evidence_level": "local_smoke",
    "no_claims": [
      "FASTQ export comparator parity",
      "broad comparator parity"
    ]
  },
  "type": "object",
  "required": ["benchmark", "version", "profile", "iterations", "fixture", "results", "notes"],
  "properties": {
    "benchmark": { "const": "fastq_microbench" },
    "version": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["small", "medium", "large"] },
    "iterations": { "type": "integer", "minimum": 1 },
    "fixture": {
      "type": "object",
      "required": [
        "plain_path",
        "gzip_path",
        "records",
        "sequence_len",
        "plain_file_bytes",
        "gzip_file_bytes",
        "kept"
      ],
      "properties": {
        "plain_path": { "type": "string" },
        "gzip_path": { "type": "string" },
        "records": { "type": "integer", "minimum": 0 },
        "sequence_len": { "type": "integer", "minimum": 0 },
        "plain_file_bytes": { "type": "integer", "minimum": 0 },
        "gzip_file_bytes": { "type": "integer", "minimum": 0 },
        "kept": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "plain_parse_throughput",
        "gzip_parse_throughput",
        "plain_writer_throughput",
        "gzip_writer_throughput",
        "command_timings"
      ],
      "properties": {
        "plain_parse_throughput": { "$ref": "#/$defs/measurement" },
        "gzip_parse_throughput": { "$ref": "#/$defs/measurement" },
        "plain_writer_throughput": { "$ref": "#/$defs/measurement" },
        "gzip_writer_throughput": { "$ref": "#/$defs/measurement" },
        "command_timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_timing" }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "operation",
        "iterations",
        "records_per_iteration",
        "bytes_per_iteration",
        "total_seconds",
        "min_seconds",
        "mean_seconds",
        "max_seconds",
        "records_per_second",
        "bytes_per_second",
        "checksum"
      ],
      "properties": {
        "operation": {
          "enum": [
            "plain_parse_throughput",
            "gzip_parse_throughput",
            "plain_writer_throughput",
            "gzip_writer_throughput"
          ]
        },
        "iterations": { "type": "integer", "minimum": 1 },
        "records_per_iteration": { "type": "integer", "minimum": 0 },
        "bytes_per_iteration": { "type": "integer", "minimum": 0 },
        "total_seconds": { "type": "number", "minimum": 0 },
        "min_seconds": { "type": "number", "minimum": 0 },
        "mean_seconds": { "type": "number", "minimum": 0 },
        "max_seconds": { "type": "number", "minimum": 0 },
        "records_per_second": { "type": "number", "minimum": 0 },
        "bytes_per_second": { "type": "number", "minimum": 0 },
        "checksum": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "command_timing": {
      "type": "object",
      "required": [
        "command",
        "iterations",
        "ok_count",
        "total_seconds",
        "min_seconds",
        "mean_seconds",
        "max_seconds",
        "exit_codes"
      ],
      "properties": {
        "command": {
          "enum": [
            "enumerate_fastq",
            "enumerate_fastq_gz",
            "subsample_fastq",
            "subsample_fastq_gz"
          ]
        },
        "command_family": { "$ref": "#/$defs/command_family" },
        "evidence_level": { "$ref": "#/$defs/evidence_level" },
        "evidence_source": { "type": "string" },
        "comparator_scope": { "type": "string" },
        "iterations": { "type": "integer", "minimum": 1 },
        "ok_count": { "type": "integer", "minimum": 0 },
        "total_seconds": { "type": "number", "minimum": 0 },
        "min_seconds": { "type": "number", "minimum": 0 },
        "mean_seconds": { "type": "number", "minimum": 0 },
        "max_seconds": { "type": "number", "minimum": 0 },
        "exit_codes": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "command_family": {
      "type": "string",
      "enum": ["fastq"]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "public_profile_comparator",
        "scenario_matrix_comparator_scaffold",
        "local_smoke",
        "no_external_comparator_claim"
      ]
    }
  }
}
