{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamana.dev/benchmarks/results/scanner_microbench.schema.json",
  "title": "Bamana Native BAM Scanner Microbenchmark Result",
  "type": "object",
  "required": ["benchmark", "version", "profile", "iterations", "fixture", "results", "notes"],
  "properties": {
    "benchmark": { "const": "scanner_microbench" },
    "version": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["small", "medium", "large"] },
    "iterations": { "type": "integer", "minimum": 1 },
    "fixture": {
      "type": "object",
      "required": [
        "path",
        "records",
        "references",
        "sequence_len",
        "serialized_payload_bytes",
        "bgzf_file_bytes",
        "kept"
      ],
      "properties": {
        "path": { "type": "string" },
        "records": { "type": "integer", "minimum": 0 },
        "references": { "type": "integer", "minimum": 0 },
        "sequence_len": { "type": "integer", "minimum": 0 },
        "serialized_payload_bytes": { "type": "integer", "minimum": 0 },
        "bgzf_file_bytes": { "type": "integer", "minimum": 0 },
        "kept": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "record_scan_throughput",
        "selective_field_extraction_throughput",
        "command_timings"
      ],
      "properties": {
        "record_scan_throughput": { "$ref": "#/$defs/measurement" },
        "selective_field_extraction_throughput": { "$ref": "#/$defs/measurement" },
        "command_timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_timing" }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "operation",
        "iterations",
        "records_per_iteration",
        "bytes_per_iteration",
        "total_seconds",
        "min_seconds",
        "mean_seconds",
        "max_seconds",
        "records_per_second",
        "bytes_per_second",
        "checksum"
      ],
      "properties": {
        "operation": {
          "enum": [
            "record_scan_throughput",
            "selective_field_extraction_throughput"
          ]
        },
        "iterations": { "type": "integer", "minimum": 1 },
        "records_per_iteration": { "type": "integer", "minimum": 0 },
        "bytes_per_iteration": { "type": "integer", "minimum": 0 },
        "total_seconds": { "type": "number", "minimum": 0 },
        "min_seconds": { "type": "number", "minimum": 0 },
        "mean_seconds": { "type": "number", "minimum": 0 },
        "max_seconds": { "type": "number", "minimum": 0 },
        "records_per_second": { "type": "number", "minimum": 0 },
        "bytes_per_second": { "type": "number", "minimum": 0 },
        "checksum": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "command_timing": {
      "type": "object",
      "required": [
        "command",
        "iterations",
        "ok_count",
        "total_seconds",
        "min_seconds",
        "mean_seconds",
        "max_seconds",
        "exit_codes"
      ],
      "properties": {
        "command": { "enum": ["summary", "check_sort", "check_map", "validate", "check_tag", "subsample_bam", "sort", "merge", "checksum", "explode", "consume", "check_map_region_scan_fallback", "summary_region_scan_fallback", "select_region_scan_fallback", "index_bam", "check_index", "check_map_indexed", "summary_indexed", "check_map_region_indexed", "summary_region_indexed", "select_region_indexed_output", "inspect_duplication", "deduplicate", "forensic_inspect"] },
        "iterations": { "type": "integer", "minimum": 1 },
        "ok_count": { "type": "integer", "minimum": 0 },
        "total_seconds": { "type": "number", "minimum": 0 },
        "min_seconds": { "type": "number", "minimum": 0 },
        "mean_seconds": { "type": "number", "minimum": 0 },
        "max_seconds": { "type": "number", "minimum": 0 },
        "exit_codes": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
