{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamana.dev/spec/jsonschema/summary.schema.json",
  "title": "Bamana Summary Response",
  "description": "Contract for bamana summary JSON output.",
  "x-bamana-command": "summary",
  "x-bamana-contract-version": "0.1.0",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_used", "index_used", "records_scanned", "full_file_scanned"],
      "properties": {
        "header_used": { "type": "boolean" },
        "index_used": { "type": "boolean" },
        "records_scanned": { "type": "integer", "minimum": 0 },
        "full_file_scanned": { "type": "boolean" }
      }
    },
    "headerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references_defined", "sort_order", "sub_sort_order", "group_order"],
      "properties": {
        "references_defined": { "type": "integer", "minimum": 0 },
        "sort_order": { "$ref": "./common/defs.schema.json#/$defs/nullableString" },
        "sub_sort_order": { "$ref": "./common/defs.schema.json#/$defs/nullableString" },
        "group_order": { "$ref": "./common/defs.schema.json#/$defs/nullableString" }
      }
    },
    "mapq": {
      "type": "object",
      "additionalProperties": true,
      "required": ["min", "max", "mean", "zero_count"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "zero_count": { "type": "integer", "minimum": 0 }
      }
    },
    "normalizedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "reference_name",
        "reference_index",
        "reference_length",
        "start_0_based",
        "end_0_based_exclusive",
        "start_1_based_inclusive",
        "end_1_based_inclusive",
        "input_kind"
      ],
      "properties": {
        "original": { "type": "string" },
        "reference_name": { "type": "string" },
        "reference_index": { "type": "integer", "minimum": 0 },
        "reference_length": { "type": "integer", "minimum": 1 },
        "start_0_based": { "type": "integer", "minimum": 0 },
        "end_0_based_exclusive": { "type": "integer", "minimum": 1 },
        "start_1_based_inclusive": { "type": "integer", "minimum": 1 },
        "end_1_based_inclusive": { "type": "integer", "minimum": 1 },
        "input_kind": {
          "type": "string",
          "enum": ["whole_reference", "explicit_interval"]
        }
      }
    },
    "regionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "source",
        "coordinate_base",
        "interval_semantics",
        "duplicate_policy",
        "regions",
        "execution"
      ],
      "properties": {
        "requested": { "type": "boolean" },
        "source": { "type": "string", "enum": ["cli_regions"] },
        "coordinate_base": {
          "type": "string",
          "enum": ["input_1_based_closed_output_0_based_half_open"]
        },
        "interval_semantics": { "type": "string" },
        "duplicate_policy": {
          "type": "string",
          "enum": ["preserve_request_order_without_merging_or_deduplication"]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/normalizedRegion" }
        },
        "execution": {
          "type": "string",
          "enum": ["indexed", "scan_fallback", "rejected"]
        },
        "index_path": { "type": "string" },
        "fallback_mode": {
          "type": "string",
          "enum": ["native_scan_required"]
        },
        "scan_records_limit": { "type": "integer", "minimum": 1 },
        "chunks_traversed": { "type": "integer", "minimum": 0 },
        "raw_records_seen": { "type": "integer", "minimum": 0 },
        "duplicate_records_suppressed": { "type": "integer", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "indexDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "kind", "used"],
      "properties": {
        "present": { "type": "boolean" },
        "kind": { "$ref": "./common/defs.schema.json#/$defs/indexKind" },
        "used": { "type": "boolean" },
        "total_mapped_reads": { "type": "integer", "minimum": 0 },
        "total_unmapped_reads": { "type": "integer", "minimum": 0 },
        "references_with_mapped_reads": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "format",
        "mode",
        "evidence",
        "header",
        "counts",
        "mapping",
        "anomalies",
        "confidence",
        "semantic_note"
      ],
      "properties": {
        "format": { "const": "BAM" },
        "mode": {
          "type": "string",
          "enum": ["bounded_scan", "full_scan", "indeterminate"]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "header": { "$ref": "#/$defs/headerSummary" },
        "counts": { "type": "object" },
        "fractions": { "type": "object" },
        "fractions_observed": { "type": "object" },
        "mapq": { "$ref": "#/$defs/mapq" },
        "mapping": { "type": "object" },
        "region_scope": { "$ref": "#/$defs/regionScope" },
        "anomalies": { "type": "object" },
        "index_derived": { "$ref": "#/$defs/indexDerived" },
        "confidence": { "$ref": "./common/defs.schema.json#/$defs/confidenceLevel" },
        "semantic_note": { "type": "string" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "path", "data", "error"],
      "properties": {
        "ok": { "const": true },
        "command": { "const": "summary" },
        "path": { "$ref": "./common/defs.schema.json#/$defs/pathOrNull" },
        "analysis_wall_seconds": { "type": "number", "minimum": 0 },
        "data": { "$ref": "#/$defs/data" },
        "error": { "type": "null" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "path", "data", "error"],
      "properties": {
        "ok": { "const": false },
        "command": { "const": "summary" },
        "path": { "$ref": "./common/defs.schema.json#/$defs/pathOrNull" },
        "analysis_wall_seconds": { "type": "number", "minimum": 0 },
        "data": { "oneOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] },
        "error": { "$ref": "./common/json_error.schema.json" }
      }
    }
  ]
}
