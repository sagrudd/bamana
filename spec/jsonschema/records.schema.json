{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamana.dev/spec/jsonschema/records.schema.json",
  "title": "Bamana Records Response",
  "description": "Filtered normalized-BAM records for the AlleleAnchor adapter.",
  "x-bamana-command": "records",
  "x-bamana-contract-version": "1.0",
  "$defs": {
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "type", "value", "raw_payload_hex"],
      "properties": {
        "tag": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]$"},
        "type": {"type": "string", "minLength": 1},
        "value": {},
        "raw_payload_hex": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "array_subtype": {"type": ["string", "null"]}
      }
    },
    "normalized_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "reference_name", "reference_index", "reference_length", "start_0_based", "end_0_based_exclusive", "start_1_based_inclusive", "end_1_based_inclusive", "input_kind"],
      "properties": {
        "original": {"type": "string", "minLength": 1},
        "reference_name": {"type": "string", "minLength": 1},
        "reference_index": {"type": "integer", "minimum": 0},
        "reference_length": {"type": "integer", "minimum": 1},
        "start_0_based": {"type": "integer", "minimum": 0},
        "end_0_based_exclusive": {"type": "integer", "minimum": 1},
        "start_1_based_inclusive": {"type": "integer", "minimum": 1},
        "end_1_based_inclusive": {"type": "integer", "minimum": 1},
        "input_kind": {"enum": ["whole_reference", "explicit_interval"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_id", "reference_name", "reference_start", "reference_end", "mapping_quality", "flags", "cigar", "sequence", "qualities", "auxiliary_tags"],
      "properties": {
        "read_id": {"type": "string", "minLength": 1},
        "reference_name": {"type": "string", "minLength": 1},
        "reference_start": {"type": "integer", "minimum": 0},
        "reference_end": {"type": "integer", "minimum": 0},
        "mapping_quality": {"type": "integer", "minimum": 0, "maximum": 255},
        "flags": {"type": "integer", "minimum": 0, "maximum": 65535},
        "cigar": {"type": "string", "minLength": 1},
        "sequence": {"type": "string", "minLength": 1},
        "qualities": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 93}},
        "auxiliary_tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_id", "reason", "flags", "mapping_quality", "auxiliary_tags"],
      "properties": {
        "read_id": {"type": "string", "minLength": 1},
        "reason": {"enum": ["unmapped", "non_primary", "duplicate", "qcfail", "low_mapq"]},
        "flags": {"type": "integer", "minimum": 0, "maximum": 65535},
        "mapping_quality": {"type": "integer", "minimum": 0, "maximum": 255},
        "auxiliary_tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}}
      }
    },
    "stream_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "ok", "input", "reference", "filters", "region_scope", "stream", "rejection_counts", "provenance", "error"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "aligned_record_stream"},
        "ok": {"const": true},
        "input": {"type": "object", "additionalProperties": false, "required": ["object_id", "format"], "properties": {"object_id": {"type": "string", "minLength": 1}, "format": {"const": "bam"}}},
        "reference": {"type": "object", "additionalProperties": false, "required": ["assembly", "object_id", "fasta_sha256", "fai_sha256", "source_used"], "properties": {"assembly": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "minLength": 1}, "fasta_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "fai_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_used": {"const": "explicit_fasta"}}},
        "filters": {"type": "object", "additionalProperties": false, "required": ["requested", "retained", "rejected"], "properties": {"requested": {"type": "integer", "minimum": 0}, "retained": {"type": "integer", "minimum": 0}, "rejected": {"type": "integer", "minimum": 0}}},
        "region_scope": {"type":["object","null"],"additionalProperties":false,"required":["coordinate_base","interval_semantics","duplicate_policy","regions","execution","index_path","chunks_traversed","raw_records_seen","duplicate_records_suppressed"],"properties":{"coordinate_base":{"const":"input_1_based_closed_output_0_based_half_open"},"interval_semantics":{"type":"string","minLength":1},"duplicate_policy":{"const":"deduplicate_physical_records_by_virtual_offset"},"regions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/normalized_region"}},"execution":{"const":"indexed_stream"},"index_path":{"type":"string","minLength":1},"chunks_traversed":{"type":"integer","minimum":0},"raw_records_seen":{"type":"integer","minimum":0},"duplicate_records_suppressed":{"type":"integer","minimum":0}}},
        "stream": {"type": "object", "additionalProperties": false, "required": ["format", "path", "ordering", "record_kind_field"], "properties": {"format": {"const": "application/x-ndjson"}, "path": {"type": "string", "minLength": 1}, "ordering": {"const": "source_virtual_offset_order"}, "record_kind_field": {"const": "kind"}}},
        "rejection_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["bamana_version", "bamana_git_commit", "execution_mode", "command"], "properties": {"bamana_version": {"type": "string", "minLength": 1}, "bamana_git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "execution_mode": {"enum": ["host_binary", "container"]}, "container_image": {"type": ["string", "null"]}, "container_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}}},
        "error": {"type": "null"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "ok", "input", "reference", "filters", "region_scope", "records", "rejections", "provenance", "error"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "aligned_records"},
        "ok": {"const": true},
        "input": {"type": "object", "additionalProperties": false, "required": ["object_id", "format"], "properties": {"object_id": {"type": "string", "minLength": 1}, "format": {"const": "bam"}}},
        "reference": {"type": "object", "additionalProperties": false, "required": ["assembly", "object_id", "fasta_sha256", "fai_sha256", "source_used"], "properties": {"assembly": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "minLength": 1}, "fasta_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "fai_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_used": {"const": "explicit_fasta"}}},
        "filters": {"type": "object", "additionalProperties": false, "required": ["requested", "retained", "rejected"], "properties": {"requested": {"type": "integer", "minimum": 0}, "retained": {"type": "integer", "minimum": 0}, "rejected": {"type": "integer", "minimum": 0}}},
        "region_scope": {"type":["object","null"],"additionalProperties":false,"required":["coordinate_base","interval_semantics","duplicate_policy","regions","execution","index_path","chunks_traversed","raw_records_seen","duplicate_records_suppressed"],"properties":{"coordinate_base":{"const":"input_1_based_closed_output_0_based_half_open"},"interval_semantics":{"type":"string","minLength":1},"duplicate_policy":{"const":"deduplicate_physical_records_by_virtual_offset"},"regions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/normalized_region"}},"execution":{"const":"indexed"},"index_path":{"type":"string","minLength":1},"chunks_traversed":{"type":"integer","minimum":0},"raw_records_seen":{"type":"integer","minimum":0},"duplicate_records_suppressed":{"type":"integer","minimum":0}}},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "rejections": {"type": "array", "items": {"$ref": "#/$defs/rejection"}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["bamana_version", "bamana_git_commit", "execution_mode", "command"], "properties": {"bamana_version": {"type": "string", "minLength": 1}, "bamana_git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "execution_mode": {"enum": ["host_binary", "container"]}, "container_image": {"type": ["string", "null"]}, "container_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}}},
        "error": {"type": "null"}
      }
    }
  },
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["ok", "command", "path", "data", "error"], "properties": {"ok": {"const": true}, "command": {"const": "records"}, "path": {"$ref": "./common/defs.schema.json#/$defs/pathOrNull"}, "analysis_wall_seconds": {"type": "number", "minimum": 0}, "data": {"oneOf": [{"$ref": "#/$defs/data"}, {"$ref": "#/$defs/stream_data"}]}, "error": {"type": "null"}}},
    {"type": "object", "additionalProperties": false, "required": ["ok", "command", "path", "data", "error"], "properties": {"ok": {"const": false}, "command": {"const": "records"}, "path": {"$ref": "./common/defs.schema.json#/$defs/pathOrNull"}, "analysis_wall_seconds": {"type": "number", "minimum": 0}, "data": {"type": ["null", "object"]}, "error": {"$ref": "./common/json_error.schema.json"}}}
  ]
}
